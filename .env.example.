# ==========================================
# KONFIGURASI TELEGRAM
# ==========================================
# Dapatkan token dari @BotFather
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ
# ID Channel atau Grup (biasanya diawali -100...)
TELEGRAM_CHAT_ID=-1001234567890

# ==========================================
# KONFIGURASI BINANCE FUTURES API
# ==========================================
# Buat API Key di Binance -> API Management
# Pastikan centang "Enable Futures"
BINANCE_FUTURES_API_KEY=your_api_key_here
BINANCE_FUTURES_API_SECRET=your_api_secret_here

# true = Testnet (Uang Palsu), false = Live (Uang Asli)
BINANCE_FUTURES_TESTNET=true

# ==========================================
# PARAMETER TRADING
# ==========================================
# Pair yang ditradingkan (BTCUSDT atau BTCUSDC untuk akun Cent)
SYMBOL=BTCUSDT

# Timeframe candle (15m, 1h, 4h, dll)
INTERVAL=1h

# Leverage (Disarankan 2 atau 3 untuk keamanan)
LEVERAGE=3

# Tipe Margin (ISOLATED atau CROSSED)
MARGIN_TYPE=ISOLATED

# Jeda pengecekan sinyal dalam detik (300 = 5 menit)
POLL_INTERVAL_SEC=300
